# =============================================================================
# PODAR PATHWAYS - ENVIRONMENT TEMPLATE (.env.example)
# =============================================================================

# Server Environment
PORT=5000
APP_ENV=production
ADMIN_KEY=

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (phpMyAdmin / MySQL)
# -----------------------------------------------------------------------------
DB_DRIVER=mysql

# MySQL Production Credentials (from cPanel / phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=podar_pathways
DB_USER=podar_user
DB_PASS=
DB_CERTIFICATES_NAME=podar_certificates
DB_PROJECTS_NAME=podar_projects

# -----------------------------------------------------------------------------
# SMTP Email Configuration (PHP OTP service)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
USE_SMTP=true
SMTP_USER=noreply@podarpathways.edu
SMTP_PASS=
EMAIL_FROM=noreply@podarpathways.edu
MAIL_FROM_NAME="Podar Pathways Academic Board"

# -----------------------------------------------------------------------------
# Frontend Vite Configuration
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_APP_NAME="Podar Pathways"
VITE_APP_TAGLINE="Career Operating System"
