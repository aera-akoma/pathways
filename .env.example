# =============================================================================
# PODAR PATHWAYS - ENVIRONMENT TEMPLATE (.env.example)
# =============================================================================

# Server Environment
PORT=5000
NODE_ENV=production
ADMIN_KEY=drHPSingh

# -----------------------------------------------------------------------------
# MULTI-DATABASE CONFIGURATION: 3 SEPARATE DATABASES
# -----------------------------------------------------------------------------
# Mode: 'sqlite' (local / instant zero-config) or 'mysql' (cPanel / production)
DB_DRIVER=sqlite

# 1. Main Core Database (Students, Admins, Courses, OTPs, Settings)
DB_MAIN_PATH=./public/api/data/podar_pathways.db
DATABASE_URL=./public/api/data/podar_pathways.db

# 2. Certificates Database (Student Credentials, Badges & Verifications)
DB_CERTIFICATES_PATH=./public/api/data/certificates.db

# 3. Projects Database (Student Posts, Images, Comments, Likes, Bookmarks)
DB_PROJECTS_PATH=./public/api/data/projects.db

# MySQL Production Credentials (when DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=podar_pathways
DB_USER=podar_user
DB_PASS=Podar@StrongPassword2026!
DB_CERTIFICATES_NAME=podar_certificates
DB_PROJECTS_NAME=podar_projects

# -----------------------------------------------------------------------------
# SMTP Email Configuration (Nodemailer / OTP 2FA Service)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@podarpathways.edu
SMTP_PASS=
EMAIL_FROM="Podar Pathways Academic Board <noreply@podarpathways.edu>"

# -----------------------------------------------------------------------------
# Frontend Vite Configuration
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_APP_NAME="Podar Pathways"
VITE_APP_TAGLINE="Career Operating System"
