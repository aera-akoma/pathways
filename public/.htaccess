# Podar Pathways - Production SPA .htaccess
Options -Indexes -MultiViews
DirectoryIndex index.html

# Block direct browser access to sensitive files (.env, .sql, .log, etc.)
<FilesMatch "^\.|\.(env|sql|log|ini|sh|bak)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forbid direct HTTP access to .env and database files
  RewriteRule ^(\.env|database\.sql|.*\.log) - [F,L]
  RewriteRule ^api/(?:logs(?:/|$)|.*\.(?:php|json|sql|ini|bak)$) - [F,L,NC]

  # Route legacy /public/api requests cleanly
  RewriteRule ^public/api(?:/.*)?$ api/index.php [QSA,L]

  # Route legacy /public/ static assets cleanly
  RewriteRule ^public/(.*)$ $1 [QSA,L]

  # Route API roots and nested endpoints before the SPA fallback
  RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]

  # Allow direct access to existing files and directories (assets, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other web URL paths (e.g. /projects, /courses, /opportunities) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Ensure correct MIME type for JavaScript module scripts, XML, and text
AddType application/javascript .js .mjs .jsx .ts .tsx
AddType application/xml .xml
AddType text/plain .txt

<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>
  <Files "sitemap.xml">
    Header set Content-Type "application/xml; charset=UTF-8"
    Header set Access-Control-Allow-Origin "*"
  </Files>
  <Files "robots.txt">
    Header set Content-Type "text/plain; charset=UTF-8"
  </Files>
</IfModule>

# Caching & MIME types
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Organization demo video MIME types.
AddType video/mp4 .mp4
AddType video/webm .webm
