# Podar Pathways - Production SPA .htaccess

# Block direct browser access to sensitive files (.env, .sql, .log, etc.)
<FilesMatch "^\.|\.(env|sql|log|ini|sh|bak)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forbid direct HTTP access to .env and database files
  RewriteRule ^(\.env|database\.sql|.*\.log) - [F,L]

  # Allow direct access to existing files and directories (assets, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Allow direct pass-through for API requests to backend PHP handler
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^ - [L]

  # Route all other web URL paths (e.g. /projects, /courses, /opportunities) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Caching & MIME types
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
